// Cloudflare Workers deployment: the app (static files in app/) plus the /api sync API.
// "name" must match the Worker's name in the Cloudflare dashboard.
// Secrets (Settings > Variables and secrets): SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY.
{
  "name": "tallyentry",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./app",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Keep variables set in the dashboard when deploying from GitHub.
  "keep_vars": true,
  // Needed by "npx wrangler preview", which Cloudflare runs for pull request branches.
  "previews": {}
}
